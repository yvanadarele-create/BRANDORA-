# Brandora — environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
# NEVER put a real key in this file, in code, in a comment, or in a commit
# message. Secrets belong in your local `.env` and in the deployment's encrypted
# environment variables — nowhere else.

# --- Supplier sourcing (AliExpress) ---------------------------------------

# OPTIONAL — nothing in the MVP request path reads these. The adapter in
# packages/brandora-sourcing is built and tested but not mounted on a route; the
# only place the names appear at runtime is the admin Integrations screen, which
# shows a mask of the last four characters so you can tell whether a key is
# installed. Leave them blank until live sourcing is switched on.
#
# Read only by packages/brandora-config, used only by packages/brandora-sourcing,
# which runs server-side.
#
# The App Key is public in AliExpress's model; the other three are not. The App
# Secret signs every request, and the Refresh Token outlives the Access Token —
# a leak of either is a leak of the whole integration, so neither belongs in a
# file, a screenshot, a chat message, or a log line.
#
# In production these are encrypted environment variables in the deployment,
# entered by the Brandora administrator. Admin → Integrations → AliExpress shows
# only a mask of the last four characters, never a value.
#
# If any of these has ever been pasted into a chat, an issue, or a commit,
# rotate it in the AliExpress console before doing anything else.
ALIEXPRESS_APP_KEY=replace_me
ALIEXPRESS_APP_SECRET=replace_me
ALIEXPRESS_ACCESS_TOKEN=replace_me
ALIEXPRESS_REFRESH_TOKEN=replace_me

# The gateway. Override only to point at a regional or sandbox endpoint.
ALIEXPRESS_ENDPOINT=https://api-sg.aliexpress.com/sync

# --- Commercial settings --------------------------------------------------

# Business numbers, deliberately configurable: a margin that can only be changed
# by a deploy is a margin nobody tunes.

# Launch currency. XOF is zero-decimal — see packages/brandora-shared/src/money.ts.
BRANDORA_DEFAULT_CURRENCY=XOF

# Brandora's margin on (product cost + shipping cost). 0.30 = 30%.
# Clamped to 0.25–0.35 — see MARGIN_RATE_MIN/MAX in packages/brandora-config.
BRANDORA_MARGIN_RATE=0.30

# Local handling, storage and last-mile coordination, as a rate on goods.
BRANDORA_LOGISTICS_RATE=0.08

# Where the sourcing strategy changes gear: small orders go to low-MOQ
# suppliers, large ones justify approaching manufacturers directly.
BRANDORA_SOURCING_SMALL_MAX=50
BRANDORA_SOURCING_MEDIUM_MAX=500

# How long cached supplier prices and stock stay fresh. Past this they are still
# served during a supplier outage, but labelled as stale.
BRANDORA_SUPPLIER_CACHE_TTL_MINUTES=360

# --- Brandora persistence and auth ----------------------------------------

# --- Persistence ----------------------------------------------------------

# SECRET (it carries the database password).
#
# A Postgres connection string. Its presence is what selects Postgres; without
# it Brandora falls back to SQLite at BRANDORA_DATABASE_PATH.
#
# REQUIRED on any serverless deployment. A function's local filesystem is
# discarded between invocations, so a file-backed database there loses the
# account it created a moment earlier.
#
# Use your provider's *pooled* endpoint, not the direct one. Hundreds of
# function instances against a direct endpoint exhaust max_connections, and the
# symptom is "too many clients already" on a fraction of requests — which reads
# like a random outage rather than a configuration mistake.
#
#   Neon      …-pooler.region.aws.neon.tech
#   Supabase  aws-0-region.pooler.supabase.com:6543
#   Vercel    the POSTGRES_URL Vercel injects is already pooled
#
# TLS is negotiated from the URL: on by default, off for localhost or when the
# URL says sslmode=disable.
BRANDORA_DATABASE_URL=

# The SQLite file, used only when no URL is set. Fine for local development and
# for a single long-lived process with a real disk; not for serverless.
BRANDORA_DATABASE_PATH=./data/brandora.db

# Signs session cookies. Required, with no development fallback: a default here
# is a default that reaches production, and a known signing secret lets anyone
# mint a session for any account.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BRANDORA_AUTH_SECRET=

# Where Brandora is served. Used for the payment provider's return URL and for
# links in emails, so it must match the address a customer's browser sees.
BRANDORA_PUBLIC_BASE_URL=http://localhost:4100

# Where the front end lives, for the process that serves both the site and the
# API from one origin. Defaults to ./apps/brandora relative to the working
# directory.
BRANDORA_STATIC_ROOT=./apps/brandora

# --- Brandora delivery and rounding ---------------------------------------

# Brandora's own delivery charge, in minor units of BRANDORA_DEFAULT_CURRENCY.
# For XOF that is whole francs — XOF has no decimal places.
#
# These are Brandora's charges, not a carrier's quote. Nothing here is ever
# presented to a customer as a published freight price (§38).
BRANDORA_DELIVERY_FLAT=3000
BRANDORA_DELIVERY_PER_KG=1200

# Round the customer's total up to a multiple of this. 0 disables rounding.
# Always up, so rounding never eats the margin.
BRANDORA_ROUNDING_STEP=100

# --- Brandora payments (Paystack) -----------------------------------------

# SECRET. Authorises charges and signs webhook verification. Server-side only:
# checkout is initialised on the server and the customer receives an
# authorization URL, never a key.
#
# The name is PAYSTACK_SECRET_KEY exactly. Paystack's own dashboard calls it a
# "secret key", and a variable named anything else — PAYSTACKAPIKEY, say — is
# not read by anything: environment lookups are exact string matches, so a
# near-miss is indistinguishable from the variable being absent.
#
# With this unset, Brandora does not pretend to charge anyone: orders are placed
# and sit at `pending` until an administrator confirms an arranged payment.
# PAYSTACK_SECRET_KEY=

# SECRET. Verifies that a webhook really came from Paystack. Optional: when it
# is unset the secret key is used to check the signature, which is what Paystack
# itself does. Set it only if you rotate the two independently.
# PAYSTACK_WEBHOOK_SECRET=

# The Paystack API base. Override only for a regional or mock endpoint.
PAYSTACK_ENDPOINT=https://api.paystack.co

# --- Product image storage (Cloudflare R2) ---------------------------------
#
# Powers image upload in /admin-products. Unset, uploading a photo fails with
# a clear "image storage isn't set up yet" message — the product's text
# fields still save fine, and the site is not otherwise affected.
#
# Create an R2 bucket in the Cloudflare dashboard, an API token scoped to it
# (Account → R2 → Manage API tokens), and make the bucket's contents public
# (R2.dev subdomain, or your own domain) so a customer's browser can actually
# load the images — R2_PUBLIC_URL is that address, not the private API one.
#
# SECRET (the access key pair signs every upload/delete request).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Brand generation and the assistant (Anthropic) -----------------------

# SECRET. Read server-side only, by packages/brandora-ai. No key is ever sent
# to the browser: the front end calls Brandora's own endpoint, and Brandora
# calls Anthropic.
#
# The name is ANTHROPIC_API_KEY exactly — not CLAUDEAPIKEY, not CLAUDE_API_KEY.
#
# Unset, brand generation and "Ask Brandora" refuse and say so, rather than
# inventing a brand strategy that reads as though a model produced it.
# ANTHROPIC_API_KEY=

# The model to generate with. Defaults to claude-sonnet-5 when unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Transactional email (Resend) -----------------------------------------

# SECRET, and both halves are needed together: with a key but no from-address
# there is nothing to send from, so notifications stay queued in the database
# and the admin screen shows them as undelivered rather than losing them.
# RESEND_API_KEY=
# BRANDORA_EMAIL_FROM=

# --- Operations -----------------------------------------------------------

# Procurement spend, in minor units of BRANDORA_DEFAULT_CURRENCY, that the agent
# may commit without a human approving it. Unset means every purchase waits for
# an administrator — which is the right default until you trust the numbers.
# BRANDORA_AUTO_APPROVAL_LIMIT=

# --- Scheduling -----------------------------------------------------------

# The one booking link. Every "Book a call" control resolves to it, fetched at
# runtime rather than typed into each page. Unset, the controls hide themselves.
BRANDORA_CALENDLY_URL=
