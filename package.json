{
  "name": "brandora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brandora — AI-powered physical brand-building platform. Idea → Brand → Identity → Products → Sourcing → Quote → Production → Delivery.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm --filter @brandora/shared --filter @brandora/config --filter @brandora/i18n --filter @brandora/brand-engine --filter @brandora/catalog --filter @brandora/sourcing --filter @brandora/quotes --filter @brandora/database --filter @brandora/auth --filter @brandora/ai --filter @brandora/server build && node scripts/check-site.mjs",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @brandora/tests test",
    "dev": "node packages/brandora-server/dist/bin/serve.js",
    "lint": "turbo run lint",
    "migrate": "node scripts/migrate.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "dependencies": {
    "@brandora/server": "workspace:*",
    "pg": "^8.23.0",
    "@brandora/config": "workspace:*"
  }
}
